#!/usr/bin/env python3
# Version: 2.0.0 · updated 26-08-13-20-02
# sensors.gorilla — Sony VAIO Gorilla System Dashboard
# Maps every readable hardware sensor on the Sony VAIO SVE14A3AJ:
#   CPU cores (coretemp), Motherboard (acpitz), Intel HD 4000 (shared package),
#   AMD Radeon Turks (hwmon/amdgpu), Kingston DC600M Enterprise SSD (smartctl),
#   Battery wear / health / cycle count (BAT0 + sony-laptop sysfs),
#   Fan speed + thermal profile (sony-laptop), AC/Battery power (hwmon2).
# Renders a Gorilla Skynet System thin block-art banner (cyan→orange→red
# gradient) across the top, with the sensor data in two columns below so the
# whole dashboard fits a maximized window without scrolling. Falls back to a
# single stacked column on narrow terminals.
import glob
import os
import sys
import time
import argparse
import subprocess
import re
import select
import signal


def get_file_val(path, default="N/A", scale=1):
    if not os.path.exists(path):
        return default
    try:
        with open(path, "r") as f:
            val = f.read().strip()
            if scale != 1:
                return float(val) / scale
            return val
    except Exception:
        return default

def get_cpu_temps():
    readings = {}
    hwmon_dirs = glob.glob("/sys/devices/platform/coretemp.0/hwmon/hwmon*")
    if not hwmon_dirs:
        # Fallback to general thermal zones
        for path in sorted(glob.glob("/sys/class/thermal/thermal_zone*/temp")):
            try:
                zone_id = os.path.basename(os.path.dirname(path))
                temp = get_file_val(path, scale=1000.0)
                readings[f"Thermal Zone ({zone_id})"] = temp
            except Exception:
                pass
        return readings

    hwmon_dir = hwmon_dirs[0]
    inputs = glob.glob(os.path.join(hwmon_dir, "temp*_input"))
    for input_path in sorted(inputs):
        try:
            base = os.path.basename(input_path)
            prefix = base.split("_")[0]
            label_path = os.path.join(hwmon_dir, f"{prefix}_label")
            
            temp = get_file_val(input_path, scale=1000.0)
            label = f"Sensor {prefix}"
            if os.path.exists(label_path):
                label = get_file_val(label_path)
            
            # Map standard system names to friendly, clear descriptions
            if label == "Package id 0":
                label = "CPU/GPU Package Peak (Intel i7 / HD 4000)"
            elif label.startswith("Core"):
                label = f"{label} (Intel i7 CPU Core)"

                
            readings[label] = temp
        except Exception:
            pass
    return readings

def get_amd_gpu_temp():
    # Scan all hwmon dirs for amdgpu or radeon drivers
    for hwmon_dir in glob.glob("/sys/class/hwmon/hwmon*"):
        name_path = os.path.join(hwmon_dir, "name")
        if os.path.exists(name_path):
            try:
                with open(name_path, "r") as f:
                    name = f.read().strip().lower()
                if "radeon" in name or "amdgpu" in name:
                    temp_path = os.path.join(hwmon_dir, "temp1_input")
                    if os.path.exists(temp_path):
                        temp_val = get_file_val(temp_path, scale=1000.0)
                        if isinstance(temp_val, float):
                            return temp_val
            except Exception:
                pass
    return None

def get_battery_health():
    """Read battery wear level, cycle count, and Sony care limiter."""
    info = {"health_pct": "N/A", "cycles": "N/A", "care_limit": "N/A"}
    try:
        ef  = int(get_file_val("/sys/class/power_supply/BAT0/energy_full",  default="0"))
        efd = int(get_file_val("/sys/class/power_supply/BAT0/energy_full_design", default="0"))
        if efd > 0:
            info["health_pct"] = f"{(ef / efd * 100):.1f}%"
    except Exception:
        pass
    try:
        cycles = get_file_val("/sys/class/power_supply/BAT0/cycle_count")
        info["cycles"] = cycles if cycles != "N/A" else "N/A"
    except Exception:
        pass
    try:
        limit = get_file_val("/sys/devices/platform/sony-laptop/battery_care_limiter")
        info["care_limit"] = f"{limit}% cap" if limit not in ("N/A", "0") else "Off (full charge)"
    except Exception:
        pass
    return info

def get_ssd_metrics():
    metrics = {
        "temp": "N/A",
        "life": "N/A",
        "hours": "N/A",
        "writes": "N/A"
    }
    try:
        res = subprocess.run(["sudo", "smartctl", "-A", "/dev/sda"], capture_output=True, text=True, check=True)
        for line in res.stdout.splitlines():
            parts = line.split()
            if len(parts) >= 10:
                attr_id = parts[0]
                attr_name = parts[1]
                val = parts[3]
                raw = parts[9]
                
                if attr_id == "194": # Temperature_Celsius
                    temp_match = re.match(r'^(\d+)', raw)
                    if temp_match:
                        metrics["temp"] = float(temp_match.group(1))
                elif attr_id == "231": # SSD Life Left (VALUE is health percentage)
                    try:
                        metrics["life"] = f"{int(val)}%"
                    except ValueError:
                        pass
                elif attr_id == "9": # Power_On_Hours
                    try:
                        metrics["hours"] = f"{int(raw)} hrs"
                    except ValueError:
                        pass
                elif attr_id == "241": # Total_LBAs_Written (32MB units)
                    try:
                        gb_written = int(raw) * 32 / 1024
                        metrics["writes"] = f"{gb_written:.2f} GB"
                    except ValueError:
                        pass
    except Exception:
        pass
    return metrics


def get_rapl_power(sample_s=0.25):
    """CPU silicon power draw in watts via Intel RAPL energy counters.

    Returns {"package": W, "core": W, "uncore": W} or None. energy_uj is
    root-only since kernel 5.10, so reads go through sudo like smartctl.
    """
    paths = {}
    for d in glob.glob("/sys/class/powercap/intel-rapl:*"):
        name = get_file_val(os.path.join(d, "name"))
        key = {"package-0": "package", "core": "core", "uncore": "uncore"}.get(name)
        if key:
            paths[key] = os.path.join(d, "energy_uj")
    if "package" not in paths:
        return None
    keys = sorted(paths)
    files = [paths[k] for k in keys]

    def snap():
        res = subprocess.run(["sudo", "cat"] + files,
                             capture_output=True, text=True, check=True)
        return [int(v) for v in res.stdout.split()], time.monotonic()
    try:
        e1, t1 = snap()
        time.sleep(sample_s)
        e2, t2 = snap()
    except Exception:
        return None
    dt = t2 - t1
    if dt <= 0:
        return None
    watts = {}
    for k, a, b in zip(keys, e1, e2):
        if b >= a:  # skip on counter wraparound
            watts[k] = (b - a) / dt / 1_000_000.0
    return watts if "package" in watts else None

def get_frequencies():
    """Live CPU (max across cores) and Intel GPU frequencies."""
    cpu_khz = []
    for p in glob.glob("/sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq"):
        v = get_file_val(p)
        if v != "N/A":
            cpu_khz.append(int(v))
    cpu_ghz = max(cpu_khz) / 1_000_000.0 if cpu_khz else None
    gpu_cur = gpu_max = None
    for card in glob.glob("/sys/class/drm/card*/gt_cur_freq_mhz"):
        cur = get_file_val(card)
        mx = get_file_val(card.replace("gt_cur_", "gt_max_"))
        if cur != "N/A":
            gpu_cur, gpu_max = int(cur), int(mx) if mx != "N/A" else None
            break
    return cpu_ghz, gpu_cur, gpu_max

def get_throttle_stats():
    """Thermal-throttle event counts since boot (proof of harm, or of none)."""
    base = "/sys/devices/system/cpu/cpu0/thermal_throttle"
    pkg_count = get_file_val(os.path.join(base, "package_throttle_count"))
    pkg_ms = get_file_val(os.path.join(base, "package_throttle_total_time_ms"))
    if pkg_count == "N/A":
        return None
    core_count = 0
    for p in glob.glob("/sys/devices/system/cpu/cpu*/thermal_throttle/core_throttle_count"):
        v = get_file_val(p)
        if v != "N/A":
            core_count += int(v)
    return {"pkg": int(pkg_count), "pkg_ms": int(pkg_ms) if pkg_ms != "N/A" else 0,
            "cores": core_count}


# ---------------------------------------------------------------------------
# GORILLA SKYNET SYSTEM — thin outline logo, zero external dependencies.
# 3 lines tall × 27 chars wide. Cyan → orange → red true-colour gradient.
#
# Letter widths (3 chars each, 1-space separator between letters):
#   G=╔═╗/║ ╦/╚═╝  O=╔═╗/║ ║/╚═╝  R=╦═╗/╠╦╝/╩╚═  I= ╦ / ║ / ╩
#   L=╦  /║  /╚═╝  A=╔═╗/╠═╣/╩ ╩  S=╔═╗/╚═╗/╚═╝  K=╦╔═/╠╩╗/╩ ╚
#   Y=╦ ╦/╚╦╝/ ╩   N=╔╗╔/║║║/╩ ╩  E=╔══/╠══/╚══   T=╔╦╗/ ║ / ╩
#   M=╔╦╗/║║║/╩ ╩
# ---------------------------------------------------------------------------
_LOGO_RAW = [
    # ── GORILLA · SKYNET · SYSTEM, one 3-line banner row ──
    "╔═╗ ╔═╗ ╦═╗  ╦  ╦   ╦   ╔═╗   ╔═╗ ╦╔═ ╦ ╦ ╔╗╔ ╔══ ╔╦╗   ╔═╗ ╦ ╦ ╔═╗ ╔╦╗ ╔══ ╔╦╗",
    "║ ╦ ║ ║ ╠╦╝  ║  ║   ║   ╠═╣   ╚═╗ ╠╩╗ ╚╦╝ ║║║ ╠══  ║    ╚═╗ ╚╦╝ ╚═╗  ║  ╠══ ║║║",
    "╚═╝ ╚═╝ ╩╚═  ╩  ╚═╝ ╚═╝ ╩ ╩   ╚═╝ ╩ ╚  ╩  ╩ ╩ ╚══  ╩    ╚═╝  ╩  ╚═╝  ╩  ╚══ ╩ ╩",
]

ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")

def _vis_len(s):
    """Visible width of a string, ignoring ANSI colour codes."""
    return len(ANSI_RE.sub("", s))

def _pad(s, width):
    return s + " " * max(0, width - _vis_len(s))

def _own_version():
    """Read this script's own '# Version: X.Y.Z - updated TS' header.

    Single source: the stamp in the header IS the version, so displaying it can
    never drift from it. A duplicated VERSION constant is exactly the kind of
    second copy that put three revisions of this tool on one machine.
    """
    try:
        with open(os.path.abspath(__file__), "r", encoding="utf-8") as fh:
            for line in [next(fh) for _ in range(8)]:
                m = re.match(r"#\s*Version:\s*(\S+)(?:\s*\S\s*updated\s*(\S+))?", line)
                if m:
                    return m.group(1), (m.group(2) or "")
    except Exception:
        pass
    return "", ""


def _two_columns(left, right, gap=3):
    """Zip two lists of lines side by side, ANSI-aware."""
    rows = max(len(left), len(right))
    lw = max((_vis_len(l) for l in left), default=0)
    out = []
    for i in range(rows):
        l = left[i] if i < len(left) else ""
        r = right[i] if i < len(right) else ""
        out.append((_pad(l, lw) + " " * gap + r).rstrip())
    return out

def _fire_colour(x: int, width: int):
    """Map horizontal position to R,G,B: cyan→orange→red (gorilla fire palette)."""
    t = x / max(width - 1, 1)
    if t < 0.33:
        s = t / 0.33
        return int(s * 255), int(220 + s * (140 - 220)), int(255 + s * (0 - 255))
    elif t < 0.66:
        s = (t - 0.33) / 0.33
        return int(255 + s * (220 - 255)), int(140 + s * (30 - 140)), 0
    else:
        s = (t - 0.66) / 0.34
        return int(220 + s * (180 - 220)), int(30 + s * (0 - 30)), int(s * 60)

def get_skynet_logo_lines():
    """Return list of ANSI-painted block-art lines, no external deps."""
    max_w = max(len(l) for l in _LOGO_RAW)
    result = []
    for line in _LOGO_RAW:
        if not line.strip():
            result.append("")
            continue
        out = []
        for i, ch in enumerate(line):
            if ch == " ":
                out.append(" ")
            else:
                r, g, b = _fire_colour(i, max_w)
                out.append(f"\033[1;38;2;{r};{g};{b}m{ch}")
        result.append("".join(out) + "\033[0m")
    return result

def build_dashboard():
    # 1. CPU temps
    cpu_temps = get_cpu_temps()
    
    # 2. Motherboard temp (hwmon1 / acpitz)
    mboard_temp = get_file_val("/sys/class/hwmon/hwmon1/temp1_input", scale=1000.0)
    
    # 3. Sony Fan speed and thermal control profile
    fan_val = get_file_val("/sys/devices/platform/sony-laptop/fanspeed")
    fan_speed = f"{fan_val}%" if fan_val != "N/A" else "N/A"
    
    thermal_profile = get_file_val("/sys/devices/platform/sony-laptop/thermal_control")
    
    # 4. Battery & AC Power Supply status
    ac_online = get_file_val("/sys/class/power_supply/ADP1/online")
    power_source = "AC Adapter" if ac_online == "1" else "Battery"
    
    bat_charge = get_file_val("/sys/class/power_supply/BAT0/capacity")
    bat_status = get_file_val("/sys/class/power_supply/BAT0/status")
    
    bat_volts_raw = get_file_val("/sys/class/hwmon/hwmon2/in0_input", scale=1000.0)
    bat_volts = f"{bat_volts_raw:.2f} V" if isinstance(bat_volts_raw, float) else "N/A"
    
    bat_power_raw = get_file_val("/sys/class/hwmon/hwmon2/power1_input", scale=1000000.0)
    bat_power = f"{bat_power_raw:.2f} W" if isinstance(bat_power_raw, float) else "N/A"

    # Left column: temperatures, cooling, power. Right column: storage.
    db_lines = []   # left column
    db_lines.append("\033[1m[SYSTEM TEMPERATURES]\033[0m")
    
    # Format CPU Package and Cores
    pkg_temp = cpu_temps.get("CPU/GPU Package Peak (Intel i7 / HD 4000)", "N/A")
    if isinstance(pkg_temp, float):
        color = "\033[91m" if pkg_temp >= 80.0 else "\033[93m" if pkg_temp >= 70.0 else "\033[92m"
        db_lines.append(f"  {'CPU/GPU Package Peak (Intel i7 / HD 4000)':<47} : {color}{pkg_temp:.1f}°C\033[0m")
    else:
        db_lines.append(f"  {'CPU/GPU Package Peak (Intel i7 / HD 4000)':<47} : N/A")
        
    for core_label in sorted(cpu_temps.keys()):
        if "Core" in core_label:
            temp = cpu_temps[core_label]
            if isinstance(temp, float):
                color = "\033[91m" if temp >= 80.0 else "\033[93m" if temp >= 70.0 else "\033[92m"
                db_lines.append(f"  ├─ {core_label:<44} : {color}{temp:.1f}°C\033[0m")
            else:
                db_lines.append(f"  ├─ {core_label:<44} : N/A")
                
    if isinstance(mboard_temp, float):
        color = "\033[91m" if mboard_temp >= 80.0 else "\033[93m" if mboard_temp >= 70.0 else "\033[92m"
        mboard_label = "Motherboard / Chipset (Sony ACPI Zone)"
        db_lines.append(f"  ├─ {mboard_label:<44} : {color}{mboard_temp:.1f}°C\033[0m")
    else:
        db_lines.append(f"  ├─ {'Motherboard / Chipset (Sony ACPI Zone)':<44} : N/A")
        
    # Format Intel HD 4000 (Integrated GPU shares the CPU package silicon package peak temperature)
    intel_gpu_label = "Intel HD 4000 (Integrated GPU)"
    if isinstance(pkg_temp, float):
        color = "\033[91m" if pkg_temp >= 80.0 else "\033[93m" if pkg_temp >= 70.0 else "\033[92m"
        db_lines.append(f"  ├─ {intel_gpu_label:<44} : {color}{pkg_temp:.1f}°C\033[0m  (Shared Package Die)")
    else:
        db_lines.append(f"  ├─ {intel_gpu_label:<44} : N/A  (Shared Package Die)")

    # Format AMD Radeon Turks (Dedicated GPU)
    amd_temp = get_amd_gpu_temp()
    amd_gpu_label = "AMD Radeon Turks (Dedicated GPU)"
    if isinstance(amd_temp, float):
        color = "\033[91m" if amd_temp >= 80.0 else "\033[93m" if amd_temp >= 70.0 else "\033[92m"
        db_lines.append(f"  ├─ {amd_gpu_label:<44} : {color}{amd_temp:.1f}°C\033[0m")
    else:
        db_lines.append(f"  ├─ {amd_gpu_label:<44} : \033[90mOFF (Disabled in BIOS)\033[0m")
        
    # Format Kingston DC600M SSD
    ssd_metrics = get_ssd_metrics()
    ssd_temp = ssd_metrics["temp"]
    ssd_label = "Kingston DC600M Enterprise SSD"
    if isinstance(ssd_temp, float):
        color = "\033[91m" if ssd_temp >= 60.0 else "\033[93m" if ssd_temp >= 50.0 else "\033[92m"
        db_lines.append(f"  └─ {ssd_label:<44} : {color}{ssd_temp:.1f}°C\033[0m")
    else:
        db_lines.append(f"  └─ {ssd_label:<44} : N/A")
        
    db_lines.append("")
    db_lines.append("\033[1m[SYSTEM COOLING]\033[0m")
    db_lines.append(f"  System Fan Speed          : \033[94m{fan_speed}\033[0m")
    db_lines.append(f"  Active Thermal Profile    : \033[94m{thermal_profile}\033[0m")

    # thermal-profile-daemon (same repo): show whether fan profiles are on autopilot
    try:
        daemon_state = subprocess.run(
            ["systemctl", "is-active", "thermal-profile-daemon"],
            capture_output=True, text=True).stdout.strip()
    except Exception:
        daemon_state = ""
    if daemon_state == "active":
        db_lines.append("  Fan Profile Daemon        : \033[92mactive\033[0m (auto-stepping)")
    else:
        db_lines.append("  Fan Profile Daemon        : \033[90mnot running\033[0m")

    # CPU silicon power (RAPL), live frequencies, throttle evidence
    rapl = get_rapl_power()
    if rapl:
        parts = []
        if "core" in rapl:
            parts.append(f"cores {rapl['core']:.1f}")
        if "uncore" in rapl:
            parts.append(f"gpu/uncore {rapl['uncore']:.1f}")
        detail = f"  ({' + '.join(parts)} W)" if parts else ""
        db_lines.append(f"  CPU Package Power (RAPL)  : \033[95m{rapl['package']:.1f} W\033[0m{detail}")
    else:
        db_lines.append("  CPU Package Power (RAPL)  : N/A")

    cpu_ghz, gpu_cur, gpu_max = get_frequencies()
    cpu_s = f"{cpu_ghz:.2f} GHz" if cpu_ghz else "N/A"
    gpu_s = (f"{gpu_cur} MHz" + (f" (max {gpu_max})" if gpu_max else "")) if gpu_cur is not None else "N/A"
    db_lines.append(f"  CPU / GPU Frequency       : \033[96m{cpu_s}\033[0m  |  \033[96m{gpu_s}\033[0m")

    throttle = get_throttle_stats()
    if throttle is None:
        db_lines.append("  Thermal Throttling        : N/A")
    elif throttle["pkg"] == 0 and throttle["cores"] == 0:
        db_lines.append("  Thermal Throttling        : \033[92mnone since boot\033[0m")
    else:
        db_lines.append(f"  Thermal Throttling        : \033[91m{throttle['pkg']} pkg / "
                        f"{throttle['cores']} core events, {throttle['pkg_ms']/1000.0:.1f}s throttled\033[0m")

    bat_health = get_battery_health()

    db_lines.append("")
    db_lines.append("\033[1m[POWER SUPPLY & BATTERY]\033[0m")
    db_lines.append(f"  Primary Power Source      : \033[97m{power_source}\033[0m")
    if bat_charge != "N/A":
        db_lines.append(f"  Battery Charge            : \033[92m{bat_charge}%\033[0m  ({bat_status})")
    else:
        db_lines.append("  Battery Charge            : N/A")
    db_lines.append(f"  ├─ Voltage Readout        : {bat_volts}")
    db_lines.append(f"  ├─ Current Power Draw     : {bat_power}")
    db_lines.append(f"  ├─ Battery Wear (Health)  : \033[92m{bat_health['health_pct']}\033[0m  of original capacity")
    db_lines.append(f"  ├─ Charge Cycle Count     : {bat_health['cycles']}")
    care_health = get_file_val("/sys/devices/platform/sony-laptop/battery_care_health")
    db_lines.append(f"  ├─ Sony Care Limiter      : {bat_health['care_limit']}")
    db_lines.append(f"  └─ Sony Care Health       : "
                    f"{care_health + '%' if care_health != 'N/A' else 'N/A'}  (firmware's own estimate)")
    
    # Right column: storage health + lifetime projections
    right_lines = []
    right_lines.append("\033[1m[STORAGE HEALTH & WORKLOAD (Kingston DC600M 1.92TB Enterprise)]\033[0m")
    right_lines.append(f"  SSD Remaining Life (Health) : \033[92m{ssd_metrics['life']}\033[0m  (3,504 TBW rated | 1 DWPD @ 5-yr)")
    right_lines.append(f"  Total Lifetime Writes       : {ssd_metrics['writes']}")
    right_lines.append(f"  Power-On Hours              : {ssd_metrics['hours']}")

    # --- Remaining TBW Lifespan Projections ---
    TBW_TOTAL_GB   = 3_504_000.0   # 3,504 TB rated endurance (Kingston DC600M 1.92TB)
    CAPACITY_GB    = 1_920.0        # 1.92 TB drive
    try:
        written_str = ssd_metrics["writes"]  # e.g. "490.75 GB"
        written_gb  = float(written_str.split()[0])
    except Exception:
        written_gb  = 0.0
    remaining_gb = max(TBW_TOTAL_GB - written_gb, 0.0)

    def _yrs(gb_per_day):
        """Returns a formatted years string from remaining GB and a daily write rate."""
        if gb_per_day <= 0:
            return "∞"
        y = remaining_gb / gb_per_day / 365.25
        if y >= 1000:
            return f"{y:,.0f} yrs"
        return f"{y:,.1f} yrs"

    right_lines.append("")
    right_lines.append("  \033[1m[REMAINING LIFE — Real-World Projections]\033[0m")
    right_lines.append(f"  Remaining rated endurance   : {remaining_gb/1000:,.1f} TB  ({remaining_gb:,.0f} GB left to TBW limit)")
    right_lines.append("")

    # ── Category 1: Light / Normal Use ─────────────────────────────────────────
    right_lines.append("  \033[1;36m[1] NORMAL / LIGHT USE\033[0m  (browsing, YouTube, email, office)")
    right_lines.append(f"  ├─ \033[96mLight User     \033[0m (~2 GB/day)   : \033[92m{_yrs(2):<12}\033[0m\x00  OS logs, occasional downloads")
    right_lines.append(f"  ├─ \033[96mHome User      \033[0m (~5 GB/day)   : \033[92m{_yrs(5):<12}\033[0m\x00  Web browsing, YouTube, email")
    right_lines.append(f"  └─ \033[96mPower Casual   \033[0m (~10 GB/day)  : \033[92m{_yrs(10):<12}\033[0m\x00  Gaming, streaming, heavy browse")
    right_lines.append("")

    # ── Category 2: Developer / Hardcore ───────────────────────────────────────
    right_lines.append("  \033[1;33m[2] GORILLA DEVELOPER HARDCORE\033[0m  (compiling, ingesting, AI workloads)")
    right_lines.append(f"  ├─ \033[93mThis Session   \033[0m (~5 GB/day)   : \033[92m{_yrs(5):<12}\033[0m\x00  70k-doc Chroma ingest + OS (current)")
    right_lines.append(f"  ├─ \033[93mDev Average    \033[0m (~18 GB/day)  : \033[92m{_yrs(18):<12}\033[0m\x00  2x weekly browser/kernel builds + AI")
    right_lines.append(f"  ├─ \033[93mFull Throttle  \033[0m (~60 GB/day)  : \033[92m{_yrs(60):<12}\033[0m\x00  Daily browser + kernel builds + AI/logs")
    right_lines.append(f"  └─ \033[93mAbsolute Max   \033[0m (~120 GB/day) : \033[92m{_yrs(120):<12}\033[0m\x00  Compiles + 4K encode + vector DB churn")
    right_lines.append("")

    # ── Category 3: Enterprise Blast ───────────────────────────────────────────
    right_lines.append("  \033[1;31m[3] ENTERPRISE GRADE (DC600M Designed For)\033[0m")
    right_lines.append(f"  ├─ \033[91mMixed Use Ent  \033[0m (~200 GB/day) : \033[93m{_yrs(200):<12}\033[0m\x00  DB servers, virtualisation, cloud")
    right_lines.append(f"  ├─ \033[91m1 DWPD Rated   \033[0m (~1,920 GB/day): \033[91m{_yrs(1920):<11}\033[0m\x00  Kingston 5-yr spec (1 full wipe/day)")
    right_lines.append(f"  └─ \033[91mWrite Intense  \033[0m (~5,760 GB/day): \033[91m{_yrs(5760):<11}\033[0m\x00  3 DWPD — extreme HPC / txn logging")
    right_lines.append("")
    right_lines.append("  \033[90mNote: Projections from SMART attr 241 TBW counter. WAF not accounted for.\033[0m")

    # ── Layout ────────────────────────────────────────────────────────────────
    # Two columns wherever they fit, and they should fit: a 1600x900 screen is
    # the reference, which is about 178 columns at a normal terminal font. The
    # full layout wants 173, so it USED to clear that by five columns — one
    # scrollbar or a slightly wider font and it silently dropped to a stacked
    # layout for no reason the user could see. That margin was the bug.
    #
    # So degrade in steps instead of falling off a cliff. The trailing
    # descriptions on the projection rows ("Gaming, streaming, heavy browse")
    # are the widest thing here and the least load-bearing, so they go first.
    # \x00 marks where each one starts.
    if sys.stdout.isatty():
        term_cols = os.get_terminal_size().columns
    else:
        term_cols = 10 ** 6  # piped or redirected: never degrade

    def _plan(rows, tight, gap):
        rows = [l.split("\x00")[0].rstrip() if tight else l.replace("\x00", "")
                for l in rows]
        lw = max(_vis_len(l) for l in db_lines)
        rw = max(_vis_len(l) for l in rows)
        return rows, lw, rw, lw + gap + rw

    _, _, _, full_need = _plan(right_lines, False, 3)   # what the full layout wants
    _, _, _, tight_need = _plan(right_lines, True, 1)   # the narrowest it can go
    for tight, gap in ((False, 3), (True, 3), (True, 1)):
        rows, left_w, right_w, need_cols = _plan(right_lines, tight, gap)
        if term_cols >= need_cols:
            right_lines, trimmed = rows, tight
            break
    else:
        # Nothing fits side by side. Stack — but a stacked column is still 128
        # wide with the descriptions attached, so drop those too rather than
        # wrap. Stacking is already the last resort; wrapping on top of it is
        # not a layout, it is a mess.
        rows, left_w, right_w, _ = _plan(right_lines, False, 3)
        if term_cols < max(left_w, right_w):
            rows, left_w, right_w, _ = _plan(right_lines, True, 3)
        right_lines = rows
        gap, trimmed = 3, False
        need_cols = left_w + gap + right_w

    if term_cols >= need_cols:
        body = _two_columns(db_lines, right_lines, gap)
        width = need_cols
        if trimmed:
            body += ["", f"\033[90mNote: workload descriptions hidden to fit this "
                     f"{term_cols}-column terminal; showing them needs "
                     f"{full_need}.\033[0m"]
    else:
        # GORILLA OVERRIDE: say WHY it stacked. Silent degradation is worse than
        # a visible one — with no note, the stacked layout is indistinguishable
        # from the pre-two-column version of this script, and the obvious
        # conclusion is that the wrong build got installed. It is not: the
        # terminal is just narrower than the panels need.
        # Keep this SHORT: width is max(panel, hint), so a chatty note becomes
        # the widest line on screen and overflows the very terminal it is
        # apologising about. It did, at 128 characters.
        # Two short lines, not one long one: width is max(panel, hint), so a
        # single chatty line becomes the widest thing on screen.
        #
        # The second line matters more than the first. A one-shot print cannot
        # reflow — the text is already in the scrollback, and no program can
        # reach back and rewrap it. Maximising the window afterwards will not
        # change this output, so point at the mode that DOES follow the window
        # instead of leaving the user to resize and re-run.
        hints = [
            "\033[90mNote: stacked - this terminal is "
            f"{term_cols} cols; two columns need {tight_need} "
            f"({full_need} with descriptions).\033[0m",
            "\033[90m      Resizing now will not reflow this output. "
            "Use 'sensors.gorilla -w' to follow the window.\033[0m",
        ]
        body = db_lines + [""] + right_lines + [""] + hints
        width = max([left_w, right_w] + [_vis_len(h) for h in hints])

    logo_lines = get_skynet_logo_lines()
    logo_w = max(len(l) for l in _LOGO_RAW)
    logo_indent = " " * max(0, (width - logo_w) // 2)

    sep = "\033[1;36m" + "=" * width + "\033[0m"
    # Version goes ON the dashboard, not just in a header comment. A version you
    # have to open the file to read does not tell you which build you are
    # looking at — which is the whole reason for having one.
    _ver, _when = _own_version()
    _label = "SONY VAIO GORILLA SYSTEM DASHBOARD"
    if _ver:
        _label += f"   v{_ver}"
        if _when:
            _label += f" \u00b7 {_when}"
    title = "\033[1;36m" + _label.center(width) + "\033[0m"

    out = [logo_indent + l for l in logo_lines]
    out += [sep, title, sep]
    out += body
    out.append(sep)
    return "\n".join(out)

def main():
    is_interval_passed = any(arg in sys.argv for arg in ["-n", "--interval"])

    parser = argparse.ArgumentParser(
        description="Sony VAIO system dashboard. Live by default: it follows "
                    "the window, so resizing the terminal re-lays out the "
                    "dashboard instead of leaving a stale one on screen.",
        epilog="Piped or redirected output always prints once and exits, so "
               "'sensors.gorilla > file' and shell pipelines behave normally.")
    _v, _w = _own_version()
    parser.add_argument("-V", "--version", action="version",
                        version=f"sensors.gorilla {_v or 'unstamped'}"
                                + (f" (updated {_w})" if _w else ""))
    parser.add_argument("-1", "--once", action="store_true",
                        help="print one snapshot and exit (the pre-2.0 default)")
    parser.add_argument("-w", "--watch", action="store_true",
                        help="live view (now the default; kept so existing "
                             "commands and muscle memory keep working)")
    parser.add_argument("-n", "--interval", type=float, default=2.0, help="Refresh interval in seconds (default: 2.0)")
    args = parser.parse_args()

    # Live is the default (owner decision 2026-08-13). A one-shot print cannot
    # reflow when the window is resized - the text is already in the scrollback
    # - so the default that leaves a stale layout on screen was the wrong one.
    #
    # Two hard rules. Not a terminal means print once: otherwise
    # `sensors.gorilla > file`, a pipeline or a cron job would hang forever.
    # And --once must always win, so there is a way back.
    if not sys.stdout.isatty():
        should_watch = False
    elif args.once:
        should_watch = False
    else:
        should_watch = True
    del is_interval_passed

    if should_watch:
        # Follow the window. The terminal sends SIGWINCH the moment it is
        # resized; without listening for it, a maximised window keeps showing
        # the layout chosen for the old size until the next tick — up to a full
        # interval of being visibly wrong. Redraw on the signal instead.
        #
        # The wait is a select() on a self-pipe rather than time.sleep(): since
        # PEP 475 a bare sleep is RESUMED after a signal instead of returning,
        # so the redraw would still be late. set_wakeup_fd writes a byte into
        # the pipe from the C-level handler, which wakes select() immediately.
        # No polling loop, so an idle dashboard costs nothing on battery.
        wake_r = wake_w = -1
        if hasattr(signal, "SIGWINCH") and sys.stdout.isatty():
            wake_r, wake_w = os.pipe()
            os.set_blocking(wake_w, False)
            signal.set_wakeup_fd(wake_w)
            signal.signal(signal.SIGWINCH, lambda *_: None)

        def wait(seconds):
            """Sleep, but return early the moment the window is resized."""
            if wake_r < 0:
                time.sleep(seconds)
                return
            try:
                ready, _, _ = select.select([wake_r], [], [], seconds)
            except (InterruptedError, OSError):
                return
            if ready:
                try:
                    os.read(wake_r, 4096)   # drain every queued wake-up byte
                except OSError:
                    pass

        try:
            while True:
                cols = os.get_terminal_size().columns if sys.stdout.isatty() else 0
                sys.stdout.write("\033[H\033[J")     # home, then clear screen
                print(build_dashboard())
                print(f"Refreshed every {args.interval}s"
                      + (f" · window {cols} cols, redraws on resize" if cols else "")
                      + ". Press Ctrl+C to exit.")
                sys.stdout.flush()
                wait(args.interval)
        except KeyboardInterrupt:
            print("\nExiting dashboard.")
            sys.exit(0)
        finally:
            if wake_w >= 0:
                signal.set_wakeup_fd(-1)
                os.close(wake_w)
                os.close(wake_r)
    else:
        print(build_dashboard())

if __name__ == "__main__":
    main()
